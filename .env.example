# Optional server configuration; defaults are safe without environment overrides.
SESSION_EXPIRY_DAYS=30
# Set through your service environment only if overriding the persisted random key:
# SESSION_SECRET=replace-with-a-long-random-secret

# Build-time public path. Leave unset for direct access at / on the app's port.
# APP_BASE_PATH=/lists

# Optional runtime settings when an HTTPS reverse proxy runs on this machine.
# These must be set in the service environment; .env is not loaded automatically.
# LISTS_HOST=127.0.0.1
# LISTS_TLS=off
# SESSION_COOKIE_SECURE=true
